# Copier en .env.local (développement) ou .env.production (build), puis renseigner.
# Ne jamais commiter les vraies valeurs.

# TMDB : jeton d'accès en lecture (recommandé, n'apparaît pas dans les URL)…
TMDB_API_TOKEN=
# …ou, à défaut, l'ancienne clé d'API
TMDB_API_KEY=

# Anthropic : nécessaire pour Convaincs-moi et le Retrouveur
ANTHROPIC_API_KEY=

# URL publique du site (canonicals, sitemap, JSON-LD, IndexNow)
SITE_URL=https://streamactu.fr

# Google Analytics 4 : intégré au BUILD, à définir avant `npm run build` (vide = pas de GA)
NEXT_PUBLIC_GA_ID=

# IndexNow (scripts/indexnow.mjs) : clé publique servie à la racine du site
INDEXNOW_KEY=

# Plafonds quotidiens globaux des appels à l'IA (tous visiteurs confondus)
IA_PLAFOND_RETROUVER_JOUR=300
IA_PLAFOND_CONVAINCS_JOUR=1000
